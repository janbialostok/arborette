# Copy to .env and fill in secrets. .env is read by docker-compose for both
# ${VAR} interpolation and as env_file for the app containers. Host names
# (NEO4J_URI, POSTGRES_HOST, S3_ENDPOINT, OLLAMA_URL) are NOT set here: compose
# injects the in-network hostnames per service, and the Makefile test target
# injects localhost for host-run integration tests. Never commit a real .env.

# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j

# PostgreSQL database + the three role credential sets.
# Owner is the superuser the postgres image initializes; it provisions the two
# runtime LOGIN roles (db-bootstrap) and owns the migrated tables.
POSTGRES_DB=arborette
# disable for local compose; set to require/verify-full for non-local deployments.
POSTGRES_SSLMODE=disable
POSTGRES_OWNER_USER=arborette_owner
POSTGRES_OWNER_PASSWORD=change-me-owner
POSTGRES_ORCHESTRATOR_USER=arborette_orchestrator
POSTGRES_ORCHESTRATOR_PASSWORD=change-me-orchestrator
POSTGRES_SERVICE_USER=arborette_service
POSTGRES_SERVICE_PASSWORD=change-me-service

# Object store (MinIO locally; the root user/password double as the S3 keys).
S3_BUCKET=arborette
S3_REGION=us-east-1
S3_ACCESS_KEY=change-me-minio-user
S3_SECRET_KEY=change-me-minio-password
S3_PATH_STYLE=true

# Embeddings
OLLAMA_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# Sandbox Execution service. SANDBOX_MAX_TEMP_DIR_SIZE is a DuckDB size string and
# must carry a unit (e.g. 2GiB), never a bare byte count; the rest are bare byte
# counts. The sandbox also reads INTERNAL_AUTH_TOKEN (defined below) to verify every
# request, and hard-requires Postgres (the data-source ref registry it scopes
# requests against).
#
# The staging cache amortizes a data source's download and parse across a run's many
# measurements. SANDBOX_STAGE_CACHE_DIR is the cache root (empty ⇒ a boot-time temp
# dir, emptied at boot either way); SANDBOX_STAGE_CACHE_MAX_BYTES is its disk budget
# (0 disables the cache, restoring per-request staging) -- LRU-by-size eviction under
# that budget is the whole policy, so there is no separate eviction knob.
# SANDBOX_EXECUTE_CONCURRENCY caps concurrent in-flight requests; SANDBOX_MAX_BODY_BYTES
# caps each request body.
SANDBOX_PORT=8081
SANDBOX_MAX_OBJECT_BYTES=536870912
SANDBOX_MAX_TEMP_DIR_SIZE=2GiB
SANDBOX_STAGE_CACHE_DIR=
SANDBOX_STAGE_CACHE_MAX_BYTES=2147483648
SANDBOX_EXECUTE_CONCURRENCY=8
SANDBOX_MAX_BODY_BYTES=1048576

# Orchestrator/API service. ARBORETTE_LOCAL_IMPORT_DIR is the read-only import
# mount the on-disk ingestion path reads from (matches the :ro volume in compose).
# SLEEPCYCLE_WORKER_URL selects how the Phase-2 trigger dispatches: set it to the
# worker's serve-mode launch endpoint (full URL, /runs path included) to POST the
# launch over HTTP; leave it empty to keep the logging StubLauncher, so the AWS
# Batch SubmitJob seam stays the production path. Compose sets it for the local
# stack; unsetting it here is not enough to disable it there (compose environment
# wins over env_file).
ORCHESTRATOR_PORT=8080
SANDBOX_URL=http://sandbox:8081
SLEEPCYCLE_WORKER_URL=
ARBORETTE_ANALYST_ID=analyst-stub
SLEEPCYCLE_JOB_NAME=arborette-sleepcycle
ARBORETTE_LOCAL_IMPORT_DIR=/import

# Router knobs: when causal verification runs. ORCHESTRATOR_AUTOPROMOTE_ENABLED is
# the operator kill switch over autonomous promotion — it deliberately does not gate a
# verify-track goal's own claim, which is what the analyst asked to have tested.
# ORCHESTRATOR_AUTOPROMOTE_TOP_N is how many findings a completed explore run promotes,
# and ORCHESTRATOR_AUTOPROMOTE_SHRINKAGE_K is the support level at which their ranking
# stops discounting thin evidence (defaulted to the Sleep Cycle's support floor, since
# the hypothesis loop holds none of its own). ORCHESTRATOR_STALE_REVERIFY_CAP bounds
# how many stale verifications one graph correction re-dispatches.
ORCHESTRATOR_AUTOPROMOTE_ENABLED=true
ORCHESTRATOR_AUTOPROMOTE_TOP_N=5
ORCHESTRATOR_AUTOPROMOTE_SHRINKAGE_K=30
ORCHESTRATOR_STALE_REVERIFY_CAP=10

# Human review of extracted values. HITL_CONFIDENCE_THRESHOLD is the default
# below which an extraction is queued for an analyst (each goal may override it
# at registration). HITL_BLOCKING_LOOP_TIMEOUT_MINUTES bounds a run whose goal
# opted into blocking mode: such a run waits on a human before refining below a
# queued extraction, so it is bounded on a human timescale rather than by the
# loop's own 30-minute deadline.
HITL_CONFIDENCE_THRESHOLD=0.8
HITL_BLOCKING_LOOP_TIMEOUT_MINUTES=1440

# Shared secret for service-to-service writes (today the audit-append API the
# Sleep-Cycle Worker uses). Verifier and sender read this one variable, so compose
# cannot drift; split deployments must set the same value on both, because a
# mismatch is silent — the Orchestrator answers 401 and the worker swallows it, so
# runs report success with no audit trail. Empty disables the guard, the local
# default. Generate one with `openssl rand -hex 32`.
INTERNAL_AUTH_TOKEN=

# MCP Server, the read-side interface for downstream agents. ORCHESTRATOR_URL
# is the Orchestrator the submit_analyst_goal tool proxies goal registration to.
# MCP_AUTHORIZATION_TOKEN is the bearer token the server checks; empty disables
# auth entirely. Generate one with `openssl rand -hex 32` -- nothing rate-limits
# authentication attempts, so a hand-picked token is brute-forceable once the
# listener is reachable.
# MCP_PUBLIC_URL is where Anthropic's infrastructure dials the MCP server for the
# agent chat preview, so it must be publicly reachable -- the in-compose
# http://mcpserver:8082 hostname will NOT work. Locally that means a tunnel
# (e.g. `cloudflared tunnel --url http://localhost:8082`), which publishes this
# listener, so set MCP_AUTHORIZATION_TOKEN before opening one.
MCP_PORT=8082
ORCHESTRATOR_URL=http://orchestrator:8080
MCP_AUTHORIZATION_TOKEN=
MCP_PUBLIC_URL=

# Sleep-Cycle Worker. It runs one-shot per goal (see `make sleep-cycle`, the AWS
# Batch seam) or as a long-running serve mode (`-serve`) that runs one cycle per
# POST /runs, which is how the local stack drives Phase 2 through the Orchestrator's
# HTTPLauncher; SLEEPCYCLE_PORT is that serve-mode listen port (8080-8083 are taken
# by orchestrator/sandbox/mcp/web).
# It reuses SANDBOX_URL and ORCHESTRATOR_URL above. The SEARCH_ knobs tune the
# lattice search: MIN_SUPPORT is an absolute matched-row floor, MIN_LIFT a
# relative improvement over the best single segment. Because every candidate is
# measured through the sandbox, MAX_MEASUREMENTS bounds a run's query volume.
# MAX_PUBLICATIONS caps how many segments one run abstracts into Meta-Heuristics.
# Selection runs after the search, over Phase-1 findings and derived winners
# together, which is why its name carries no SEARCH_ segment.
#
# SLEEPCYCLE_POLICY selects the traversal: "uct" is the knowledge-guided tree search
# (the default, chosen by the calibration regression), "beam" is the level-wise walk
# -- set it back to revert without a deploy. It names a stage-level choice rather
# than a search knob, hence no SEARCH_ segment. Under "uct": SEARCH_UCT_EXPLORATION
# is the exploration constant, SEARCH_CAUSAL_MULTIPLIER_SCALE how much a
# fully-confident causal verification multiplies a value estimate (0 turns the
# weighting off), SEARCH_GROUNDING_FRACTION the share of the root's expansions spent
# adopting conjunctions retrieved from the Meta-Heuristic corpus, SEARCH_RETRIEVAL_K
# how many heuristics that retrieval asks for, and SEARCH_CROSS_GOAL_GROUNDING the
# kill switch narrowing it to the running goal (reuse across goals is the point, so
# it defaults on).
# SEARCH_SCHEMA_ATOMS additionally enumerates predicates from the data source's own
# schema -- one per distinct value, two per SEARCH_QUANTILE_BINS quantile cut --
# instead of searching only the predicates the hypothesis loop surfaced. It is off by
# default because the enumeration costs one model call to review and widens every
# run's search space.
SLEEPCYCLE_PORT=8084
SLEEPCYCLE_SEARCH_MAX_MEASUREMENTS=200
SLEEPCYCLE_SEARCH_BEAM_WIDTH=10
SLEEPCYCLE_SEARCH_MAX_ORDER=3
SLEEPCYCLE_SEARCH_MIN_SUPPORT=30
SLEEPCYCLE_SEARCH_MIN_LIFT=0.05
SLEEPCYCLE_MAX_PUBLICATIONS=20
SLEEPCYCLE_POLICY=uct
SLEEPCYCLE_SEARCH_SCHEMA_ATOMS=false
SLEEPCYCLE_SEARCH_UCT_EXPLORATION=1.41421356237
SLEEPCYCLE_SEARCH_CAUSAL_MULTIPLIER_SCALE=1.0
SLEEPCYCLE_SEARCH_GROUNDING_FRACTION=0.3
SLEEPCYCLE_SEARCH_RETRIEVAL_K=8
SLEEPCYCLE_SEARCH_QUANTILE_BINS=3
SLEEPCYCLE_SEARCH_CROSS_GOAL_GROUNDING=true

# Verifier (Engine B, causal discovery). Runs one-shot per (goal, data source) (the
# AWS Batch seam) or as a long-running serve mode (`-serve`) that runs one discovery
# per POST /verifications; VERIFIER_PORT is that serve-mode listen port (8080-8084
# are taken). It reuses SANDBOX_URL and ORCHESTRATOR_URL above (the latter for the
# audit client only — goal data comes from Postgres). The DISCOVERY_ knobs tune the
# conditional-independence sweep: ALPHA is the significance threshold, FDR the
# multiple-testing correction (bh or none), MAX_COND_SET the conditioning-set bound,
# BINS the quantile bin count, COLUMN_CAP the variable-count cap, MAX_TESTS the
# total-sandbox-round-trip budget. ORIENT_MAX_REPAIRS bounds the LLM orientation
# repair loop. VERIFIER_WORKER_URL selects the orchestrator's verifier launcher (set
# by compose to the serve endpoint; empty keeps the stub).
VERIFIER_PORT=8085
VERIFIER_WORKER_URL=
VERIFIER_DISCOVERY_ALPHA=0.05
VERIFIER_DISCOVERY_FDR=bh
VERIFIER_DISCOVERY_MAX_COND_SET=2
VERIFIER_DISCOVERY_BINS=4
VERIFIER_DISCOVERY_COLUMN_CAP=50
VERIFIER_DISCOVERY_MAX_TESTS=20000
VERIFIER_ORIENT_MAX_REPAIRS=2

# Sandbox analysis surface (POST /analyze) gets its own concurrency class and caps,
# separate from the execute surface.
SANDBOX_ANALYZE_CONCURRENCY=8
SANDBOX_ANALYZE_MAX_COLUMNS=4
SANDBOX_ANALYZE_MAX_BINS=32

# Web UI. Reuses ORCHESTRATOR_URL above as its BFF proxy target (the browser
# only ever talks to the orchestrator). WEBUI_PORT is the published host port
# (compose maps it to the container's fixed internal 8083).
WEBUI_PORT=8083

# LLM Provider selection: "anthropic", "deepinfra", or "ollama".
# Each provider has its own config block below; uncomment the block for the
# provider you want and set LLM_PROVIDER to match.
LLM_PROVIDER=anthropic

# Anthropic (Claude) -- the default provider. Backs Evaluation Matrix fitting,
# hypothesis-tree generation, document extraction, abstraction, and the agent
# chat preview.
# ANTHROPIC_API_KEY has no working default -- replace the placeholder below.
# Set ANTHROPIC_MODEL to a cheaper/faster model for demos (e.g. claude-haiku-4-5).
# ANTHROPIC_CHAT_MODEL backs the interactive agent chat preview, where latency
# matters more than the analytical depth the loop needs.
ANTHROPIC_API_KEY=change-me-anthropic
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_CHAT_MODEL=claude-sonnet-5

# DeepInfra -- OpenAI-compatible provider.
# DEEP_INFRA_API_KEY has no working default -- replace the placeholder below.
# DEEP_INFRA_MODEL chooses the model to use (e.g. deepseek-v3, meta-llama/Llama-3.3-70B-Instruct).
# DEEP_INFRA_BASE_URL is optional; defaults to https://api.deepinfra.com/v1/openai.
# DEEP_INFRA_API_KEY=change-me-deepinfra
# DEEP_INFRA_MODEL=meta-llama/Llama-3.3-70B-Instruct
# DEEP_INFRA_BASE_URL=https://api.deepinfra.com/v1/openai

# Ollama -- local models.
# OLLAMA_LLM_ENDPOINT is the Ollama server URL (defaults to http://localhost:11434).
# OLLAMA_LLM_MODEL chooses the model (e.g. llama3, mistral, qwen2.5).
# OLLAMA_LLM_ENDPOINT=http://localhost:11434
# OLLAMA_LLM_MODEL=llama3
