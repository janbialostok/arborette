# Secrets
.env

# Build output. /orchestrator is anchored on purpose: a bare `orchestrator`
# would also match the internal/ and cmd/ directories of that name, which
# silently breaks staging and gitignore-respecting search inside them.
/out/
*.exe
/orchestrator

# Web UI (Node/Next.js) build artifacts
/web/node_modules/
/web/.next/
/web/next-env.d.ts

# Go test/coverage artifacts
*.test
*.out

# Agentic tooling workspace
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Editor/OS
.DS_Store

# Dataset Insights feature
/internal/dataset/
/internal/question/
/internal/insight/
/pkg/storage/
/cmd/dataset-service/
/cmd/question-service/
/cmd/insight-service/
migrate
iris.csv
