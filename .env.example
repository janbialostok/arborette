# Copy to .env and fill in secrets. .env is read by docker-compose for both
# ${VAR} interpolation and as env_file for the app containers. Host names
# (NEO4J_URI, POSTGRES_HOST, S3_ENDPOINT, OLLAMA_URL) are NOT set here: compose
# injects the in-network hostnames per service, and the Makefile test target
# injects localhost for host-run integration tests. Never commit a real .env.

# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j

# PostgreSQL database + the three role credential sets.
# Owner is the superuser the postgres image initializes; it provisions the two
# runtime LOGIN roles (db-bootstrap) and owns the migrated tables.
POSTGRES_DB=arborette
# disable for local compose; set to require/verify-full for non-local deployments.
POSTGRES_SSLMODE=disable
POSTGRES_OWNER_USER=arborette_owner
POSTGRES_OWNER_PASSWORD=change-me-owner
POSTGRES_ORCHESTRATOR_USER=arborette_orchestrator
POSTGRES_ORCHESTRATOR_PASSWORD=change-me-orchestrator
POSTGRES_SERVICE_USER=arborette_service
POSTGRES_SERVICE_PASSWORD=change-me-service

# Object store (MinIO locally; the root user/password double as the S3 keys).
S3_BUCKET=arborette
S3_REGION=us-east-1
S3_ACCESS_KEY=change-me-minio-user
S3_SECRET_KEY=change-me-minio-password
S3_PATH_STYLE=true

# Embeddings
OLLAMA_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# Sandbox Execution service. SANDBOX_MAX_TEMP_DIR_SIZE is a DuckDB size string and
# must carry a unit (e.g. 2GiB), never a bare byte count.
SANDBOX_PORT=8081
SANDBOX_MAX_OBJECT_BYTES=536870912
SANDBOX_MAX_TEMP_DIR_SIZE=2GiB

# Orchestrator/API service. ARBORETTE_LOCAL_IMPORT_DIR is the read-only import
# mount the on-disk ingestion path reads from (matches the :ro volume in compose).
ORCHESTRATOR_PORT=8080
SANDBOX_URL=http://sandbox:8081
ARBORETTE_ANALYST_ID=analyst-stub
SLEEPCYCLE_JOB_NAME=arborette-sleepcycle
ARBORETTE_LOCAL_IMPORT_DIR=/import

# MCP Server, the read-side interface for downstream agents. ORCHESTRATOR_URL
# is the Orchestrator the submit_analyst_goal tool proxies goal registration to.
MCP_PORT=8082
ORCHESTRATOR_URL=http://orchestrator:8080

# Sleep-Cycle Worker (a one-shot job -- see `make sleep-cycle`).
# It reuses SANDBOX_URL and ORCHESTRATOR_URL above. The SEARCH_ knobs tune the
# lattice search: MIN_SUPPORT is an absolute matched-row floor, MIN_LIFT a
# relative improvement over the best single segment. Because every candidate is
# measured through the sandbox, MAX_MEASUREMENTS bounds a run's query volume.
SLEEPCYCLE_SEARCH_MAX_MEASUREMENTS=200
SLEEPCYCLE_SEARCH_BEAM_WIDTH=10
SLEEPCYCLE_SEARCH_MAX_ORDER=3
SLEEPCYCLE_SEARCH_MIN_SUPPORT=30
SLEEPCYCLE_SEARCH_MIN_LIFT=0.05

# Web UI. Reuses ORCHESTRATOR_URL above as its BFF proxy target (the browser
# only ever talks to the orchestrator). WEBUI_PORT is the published host port
# (compose maps it to the container's fixed internal 8083).
WEBUI_PORT=8083

# Claude (Anthropic) access for Evaluation Matrix + hypothesis-tree generation.
# ANTHROPIC_API_KEY has no working default -- replace the placeholder below.
# Set ANTHROPIC_MODEL to a cheaper/faster model for demos (e.g. claude-haiku-4-5).
ANTHROPIC_API_KEY=change-me-anthropic
ANTHROPIC_MODEL=claude-opus-4-8
